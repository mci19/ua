# Demo mode (no Azure / Dataverse / SharePoint needed)
# Set to "true" to enable an in-memory mock store + 3 testaccounts on /login.
# When true, every Azure/Dataverse/SharePoint var below can be left empty.
UA_DEMO_MODE=false

# Demo mode in production deploys is refused by default — this prevents
# accidentally collapsing real auth onto the hardcoded "demo" password.
# To enable demo mode on a production-NODE_ENV environment (e.g. a Netlify
# PoC deploy), set this to "true" as an explicit opt-in.
UA_ALLOW_DEMO_IN_PROD=false

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the deployed app. MUST include the scheme (https:// or http://).
# Example: https://ua-poc.netlify.app — NOT just "ua-poc.netlify.app".
# Optional on Netlify: trustHost is true so NextAuth auto-detects from the
# request, but if you do set it, write the full URL.
NEXTAUTH_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD) app registration  (skip in demo mode)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Dataverse environment URL (no trailing slash)  (skip in demo mode)
# e.g. https://uantwerpen.crm4.dynamics.com
DATAVERSE_URL=

# SharePoint targets resolved server-side via Graph  (skip in demo mode)
# Composite Graph site id: <hostname>,<site-guid>,<web-guid>
SHAREPOINT_SITE_ID=
# Drive id of the document library used for requests
SHAREPOINT_DRIVE_ID=
# Folder path inside the drive where request folders live
SHAREPOINT_REQUEST_FOLDER=Aanvragen

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
